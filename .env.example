NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATA_DIR=.tutupbuku-data
DEMO_BUSINESS_ID=00000000-0000-4000-8000-000000000001

APP_SECRET=replace-with-a-random-local-only-secret
TUTUPBUKU_DEV_PROXY_SECRET=replace-with-a-random-local-only-secret

# Required only when a deployed frontend calls the backend directly.
TUTUPBUKU_ALLOWED_ORIGINS=

# Use Supabase Auth for a deployed frontend; never expose the service role key to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Agent processing stays disabled until both AI_BASE_URL and AI_MODEL are set.
# Use a supported OpenAI-compatible HTTP API or a locally hosted endpoint.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=45000
MAX_PARALLEL_JOBS=2
OCR_LANGUAGES=eng

# Public HTTPS origin of the Node backend tunnel. Do not put a trailing path here.
NGROK_URL=https://your-tunnel.ngrok-free.app
# Existing VM connection test settings.
CODEBUDDY_GATEWAY_URL=https://your-tunnel.ngrok-free.app
CODEBUDDY_GATEWAY_PASSWORD=
