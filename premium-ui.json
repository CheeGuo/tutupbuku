{
  "profile": "product-admin",
  "sourceRoots": ["public", "src"],
  "locale": "en-MY",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": ["Form", "Scrollbar", "Toast", "CRUD"],
  "ownership": {
    "Select/Listbox": "native",
    "Date": "typed"
  },
  "requiredCommands": ["unit", "static", "smoke"],
  "commands": {
    "unit": "node --test",
    "static": "node --check src/server.js && node --check public/app.js && node --check src/agent-demo/server.js && node --check src/agent-demo/codebuddy-client.js && node --check public/agent-connection.js",
    "smoke": "node scripts/smoke.js"
  },
  "evidence": {
    "crudFullFlow": "test/api.test.js",
    "failurePaths": "test/api.test.js",
    "agentFlow": "test/processor.test.js",
    "connectionDemo": ["test/agent-demo.test.js", "test/agent-demo-ui.test.js"]
  }
}
