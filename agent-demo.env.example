# Copy to .env.agent-demo on the AWS VM. That file is ignored by Git.
# Set the private gateway password, for example: openssl rand -hex 24
# The demo website has no visitor login.
CODEBUDDY_GATEWAY_PASSWORD=

# Private API on the same VM. Do not use CODEBUDDY_BASE_URL for this purpose:
# that name configures the CLI's model provider and could change account billing.
AGENT_DEMO_GATEWAY_URL=http://127.0.0.1:8081
AGENT_DEMO_HOST=127.0.0.1
AGENT_DEMO_PORT=3001
AGENT_DEMO_TIMEOUT_MS=90000

# Usually unnecessary with ngrok's default Host behavior. For a Host rewrite,
# set this to the public HTTPS origin, e.g. https://example.ngrok-free.app
AGENT_DEMO_PUBLIC_ORIGIN=
