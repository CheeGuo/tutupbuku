# Copy this to .env.workbuddy on the Ubuntu VM and chmod 600 it.
# Generate each secret separately with: openssl rand -hex 32
CODEBUDDY_GATEWAY_PASSWORD=replace-with-a-private-random-secret
TUTUPBUKU_API_TOKEN=replace-with-a-different-private-random-secret
TUTUPBUKU_PYTHON=python3
TUTUPBUKU_AGENT_TIMEOUT_SECONDS=180
# --- Local frontend + backend (python -m tutupbuku.app --frontend --web-only) ---
# Put these in .env (git-ignored). The backend reads .env on start.
# CODEBUDDY_GATEWAY_URL accepts http://127.0.0.1:8081 or the https ngrok URL of the VM's gateway.
# CODEBUDDY_GATEWAY_URL=https://your-tunnel.ngrok-free.app
# CODEBUDDY_GATEWAY_PASSWORD=the-gateway-password
# Optional limits for the main agent + sub-agent flow:
# TUTUPBUKU_AGENT_TIMEOUT_SECONDS=180      # per gateway call
# TUTUPBUKU_AGENT_DEADLINE_SECONDS=600     # whole agent phase of one run
# TUTUPBUKU_MAX_AGENT_RUNS_PER_HOUR=10     # runs above this use the engine only

# --- Supabase database (Prisma schema in prisma/schema.prisma) ---
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=tutupbuku
# DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?schema=tutupbuku
