# Copy this to .env.workbuddy on the Ubuntu VM and chmod 600 it.
# Generate each secret separately with: openssl rand -hex 32
CODEBUDDY_GATEWAY_PASSWORD=replace-with-a-private-random-secret
TUTUPBUKU_API_TOKEN=replace-with-a-different-private-random-secret
TUTUPBUKU_PYTHON=python3
TUTUPBUKU_AGENT_TIMEOUT_SECONDS=180